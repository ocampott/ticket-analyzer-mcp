# Copy this file to .env and replace placeholders with your project credentials.
# Keep .env local and never commit it.
TRELLO_API_KEY=<trello-api-key>
TRELLO_TOKEN=<trello-token>
TRELLO_DEFAULT_BOARD_ID=<optional-trello-board-id>

JIRA_HOST=<company.atlassian.net>
JIRA_EMAIL=<you@example.com>
JIRA_API_TOKEN=<jira-api-token>

AZURE_DEVOPS_ORG=<organization>
AZURE_DEVOPS_PROJECT=<project>
AZURE_DEVOPS_PAT=<pat-with-work-items-read>
