{
  "name": "ticket-analyzer-mcp",
  "version": "2.2.1",
  "description": "Client-neutral MCP server for Trello cards, Jira issues and Azure DevOps work items",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocampott/ticket-analyzer-mcp.git"
  },
  "homepage": "https://github.com/ocampott/ticket-analyzer-mcp#readme",
  "bugs": {
    "url": "https://github.com/ocampott/ticket-analyzer-mcp/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "main": "dist/index.js",
  "bin": {
    "ticket-analyzer-mcp": "bin/pm-mcp.js"
  },
  "pi": {
    "extensions": [
      "./extensions/ticket-analyzer.js"
    ],
    "skills": [
      "./skills/analyze-ticket",
      "./skills/search",
      "./skills/status"
    ]
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "!dist/**/__fixtures__/**",
    "!dist/**/*.test.*",
    "bin/pm-mcp.js",
    "bin/cli.js",
    "extensions/ticket-analyzer.js",
    "skills/",
    "integrations/",
    "docs/agent-workflow.md",
    "docs/codex-install.md",
    "docs/pi-install.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    ".claude-plugin/",
    ".mcp.json",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "7.3.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "isolatedModules": true
        }
      ]
    }
  }
}
